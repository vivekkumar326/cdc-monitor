# Application server
PORT=8001
APP_HOST=127.0.0.1

# MySQL database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cdc_monitor

# Application database credentials
APP_DB_USER=your_app_db_user
APP_DB_PASSWORD=replace_with_your_app_db_password

# CDC / binlog reader credentials
CDC_DB_USER=your_cdc_db_user
CDC_DB_PASSWORD=replace_with_your_cdc_db_password
